# Dependencias y builds de la app web
node_modules/
.svelte-kit/
build/
dist/
coverage/
*.tsbuildinfo
vite.config.*.timestamp-*

# Entornos locales
.env
.env.*
!.env.example

# Restos de la version Python (solo referencia en el tag v0.1-python)
.venv/
__pycache__/
.pytest_cache/

# macOS / editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# Artefactos locales de calibraciones (escaneos, targets y curvas reales).
# Se ignoran solo en la raiz para no bloquear fixtures en src/ o tests.
/*.png
/*.tif
/*.tiff
/*.jpg
/*.jpeg
/*.layout.json
/curvas*/
/outputs/
/*.acv
/*.amp
/*.cube
/*.settings
/*ranking.json
/*comparacion*.json
/*reporte*.json

# Claude Code (configuracion personal)
.claude/settings.local.json
.claude/worktrees/

# El gitignore global excluye docs/; aqui solo se versionan los documentos listados.
!docs/
docs/*
!docs/FASE-5-DESPLIEGUE.md
